{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Aurora",
  "version": "1.0.0",
  "identifier": "com.aurora.app",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Aurora",
        "width": 1280,
        "height": 800,
        "minWidth": 960,
        "minHeight": 640,
        "resizable": true
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": ["**"]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "shortDescription": "Local-first desktop music player with ambient moods.",
    "longDescription": "Aurora is a local-first desktop music player for organizing and playing your personal music library with persistent playlists, ambient moods, custom local backgrounds, and an immersive listening experience.",
    "copyright": "Copyright © 2026 Aurora. All rights reserved.",
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      }
    }
  }
}
